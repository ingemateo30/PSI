# Módulo de administración (/admin) -----------------------------------------
# Contraseña del administrador (obligatoria: sin ella /admin queda deshabilitado).
ADMIN_PASSWORD=

# Usuario del administrador (opcional, por defecto "admin").
ADMIN_USER=admin

# Clave para firmar la sesión (opcional; por defecto se deriva de ADMIN_PASSWORD).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Almacenamiento del contenido editable ---------------------------------------
# En Vercel: conecta un almacén KV / Upstash Redis (Storage) y Vercel agrega estas dos solas.
# Si existen, el contenido se guarda ahí; si no, en un archivo JSON local.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (equivalentes de la integración Upstash: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# Solo sin KV (local o servidor con disco): carpeta del archivo JSON, por defecto ./data
CONTENT_DATA_DIR=
